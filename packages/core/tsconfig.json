{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["index.ts", "autocomplete/**/*.ts", "rules/**/*.ts"],
  "exclude": ["**/*.test.ts", "autocomplete/demo.ts", "autocomplete/test.ts"]
}
