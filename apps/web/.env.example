ELEVENLABS_API_KEY=<your_api_key_here>
GEMINI_API_KEY=<your_api_key_here>

# Set to "true" to disable the ElevenLabs WebSocket streaming TTS path and force
# the buffered REST synthesis everywhere (client-side, must be VITE_-prefixed).
VITE_DISABLE_WS_TTS=false

# Cloud sync (apps/server Cloudflare Worker). Both must be set at BUILD time to
# enable the sync engine + Google sign-in; leave unset for a local-only build.
# For the single-Worker deploy, point this at the Worker's own origin (the SPA
# and /api share it, so requests stay same-origin — no CORS).
VITE_SYNC_API_URL=https://september.<account>.workers.dev
VITE_GOOGLE_CLIENT_ID=<oauth-web-client-id>.apps.googleusercontent.com