{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "september",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",

  // Single Worker also serves the built SPA (single origin → no CORS for /api/*).
  // `pnpm sync:assets` copies the web build into ./public before deploy; a
  // placeholder index.html is committed so dev/test boot without a build.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Not "single-page-application": that answers every miss with index.html,
    // which is now the prerendered landing page. A miss falls through to the
    // Worker instead, which serves the empty shell.
    "not_found_handling": "none",
    // Not the "auto-trailing-slash" default: that answers `/help` with a 307
    // to `/help/`, a wasted round trip on every prerendered page. The app's
    // own links carry no trailing slash, so make that the canonical form and
    // serve the folder index straight from it.
    "html_handling": "drop-trailing-slash",
    // Worker code rejects retired API routes and serves the shell; everything
    // else serves static assets.
    "run_worker_first": ["/api/*"]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserManagerDO", "UserDataDO"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["UserManagerDO", "UserDataDO"]
    }
  ]
}
